# Copy to .env for local runs. Never commit .env. In Docker, secrets come from compose env / secrets.
DSE_ENV=development
DSE_LOG_LEVEL=INFO
DSE_DATABASE__URL=postgresql+asyncpg://dse:dse@localhost:5433/dse
DSE_REDIS__URL=redis://localhost:6380/0
# >= 32 bytes, random: e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
DSE_SECURITY__JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
DSE_UPSTREAM__BASE_URL=https://www.dse.com.bd
DSE_LIVE__POLL_OPEN_S=10
DSE_LIVE__POLL_CLOSED_S=60
